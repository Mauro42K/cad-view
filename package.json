{
  "name": "cad-view",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "author": "CAD View",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:Mauro42K/cad-view.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "analyze": "nx run-many -t analyze",
    "build": "nx run-many -t build",
    "clean": "nx run-many -t clean",
    "dev": "nx run @mlightcad/cad-viewer-example:dev",
    "format": "prettier --config ./.prettierrc.js --write \"packages/**/*.{ts,js,vue,json}\"",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "preview": "nx run @mlightcad/cad-viewer-example:preview",
    "test": "jest",
    "test:ci": "nx run @mlightcad/cad-viewer:build && pnpm test --runInBand",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:ci": "nx run @mlightcad/cad-viewer:build && pnpm typecheck"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.9.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@nx/js": "22.7.7",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@types/rollup-plugin-peer-deps-external": "^2.2.5",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^9.28.0",
    "globals": "^15.9.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^15.2.7",
    "nx": "22.7.7",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-visualizer": "^5.12.0",
    "ts-jest": "^29.4.12",
    "typedoc": "^0.28.20",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.4.3",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "lint-staged": {
    "*.{ts,js,vue}": [
      "prettier --config ./.prettierrc.js --write",
      "eslint --config ./.eslintrc.js --fix --quiet"
    ],
    "*.md": [
      "prettier --config ./.prettierrc.js --write"
    ]
  }
}
